<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="20dp"
    android:background="@drawable/bottom_sheet_bg">

    <!-- Title -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/ic_timer" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:text="@string/delay_sequence"
            android:textColor="@color/textGray"
            android:layout_gravity="center"
            android:textSize="15sp"
            android:fontFamily="@font/gilroy_bold"
             />
    </LinearLayout>

    <!-- Row 1 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp">

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card10"
            android:layout_width="0dp"
            android:layout_height="110dp"
            android:layout_weight="1"
            android:layout_marginEnd="8dp"
            app:cardCornerRadius="12dp"
            app:strokeColor="#1565D8"
            app:cardBackgroundColor="#F0EEEE"
            app:strokeWidth="2dp">

            <LinearLayout
                android:gravity="center"
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:background="@drawable/bg_gradient_selected"
                android:layout_height="match_parent">

                <TextView
                    android:id="@+id/tv0Sec"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/delay_0"
                    android:textSize="30sp"
                    android:fontFamily="@font/gilroy_bold"
                    android:textColor="@color/white"/>

                <TextView
                    android:id="@+id/tvQuick"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/delay_quick"
                    android:textColor="@color/white"/>
            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card30"
            android:layout_width="0dp"
            android:layout_height="110dp"
            android:layout_weight="1"
            app:cardBackgroundColor="#F0EEEE"
            app:cardCornerRadius="12dp">

            <LinearLayout
                android:gravity="center"
                android:orientation="vertical"
                android:layout_width="match_parent"

                android:layout_height="match_parent">

                <TextView
                    android:id="@+id/tv10Sec"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/delay_10"
                    android:textSize="30sp"
                    android:fontFamily="@font/gilroy_bold"
                    android:textColor="@color/textGray"/>

                <TextView
                    android:id="@+id/tvStandard"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/delay_standard"
                    android:textColor="@color/textGray"/>
            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>

    <!-- Row 2 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp">

            <!-- 45s -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card45"
                android:layout_width="0dp"
                android:layout_height="110dp"
                android:layout_weight="1"
                android:layout_marginEnd="8dp"
                app:cardCornerRadius="12dp"
                app:strokeColor="#1565D8"
                app:cardBackgroundColor="#F0EEEE"
                app:strokeWidth="2dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tv30Sec"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/delay_30"
                        android:textColor="@color/textGray"
                        android:textSize="30sp"
                        android:fontFamily="@font/gilroy_bold"
                         />

                    <TextView
                        android:id="@+id/tvSetup"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/delay_setup"
                        android:textColor="@color/textGray"
                        android:textSize="14sp" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- 60s -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card60"
                android:layout_width="0dp"
                android:layout_height="110dp"
                android:layout_weight="1"
                app:cardCornerRadius="12dp"
                app:strokeColor="#1565D8"
                app:cardBackgroundColor="#F0EEEE"
                app:strokeWidth="2dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tv60Sec"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/delay_60"
                        android:textColor="@color/textGray"
                        android:textSize="30sp"
                        android:fontFamily="@font/gilroy_bold" />

                    <TextView
                        android:id="@+id/tvLong"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/delay_long"
                        android:textColor="@color/textGray"
                        android:textSize="14sp" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>



    </LinearLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:text="@string/custom_countdown"
        android:textColor="@color/textGray"
        android:fontFamily="@font/gilroy_bold"
        android:textSize="15sp" />

    <!-- Time Box -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="72dp"
        android:layout_marginTop="10dp"
        app:cardCornerRadius="12dp"
        app:strokeColor="#1565D8"
        app:cardBackgroundColor="#F0EEEE"
        app:strokeWidth="2dp">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <EditText
                android:id="@+id/etTime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerVertical="true"
                android:layout_marginStart="16dp"
                android:background="@null"
                android:focusable="false"
                android:clickable="false"
                android:cursorVisible="false"
                android:text="00:00"
                android:textColor="@color/textGray"
                android:textSize="21sp"
                android:fontFamily="@font/gilroy_bold"/>

            <ImageView
                android:id="@+id/editTime"
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:layout_marginEnd="16dp"
                android:src="@drawable/ic_edit" />

        </RelativeLayout>

    </com.google.android.material.card.MaterialCardView>

    <!-- Call Now -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnCallNow"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:layout_marginTop="20dp"
        android:text="@string/call_now"
        android:textAllCaps="false"
        android:fontFamily="@font/gilroy_bold"
        android:textSize="18sp"
        app:iconGravity="textStart"
        android:textStyle="bold"
        android:textColor="@android:color/white"
        app:icon="@drawable/ic_video_call"
        app:iconTint="@android:color/white"
        app:backgroundTint="@null"
        android:background="@drawable/bg_call_gradient"/>
    <FrameLayout
        android:id="@+id/nativeAdContainer"
        android:layout_width="match_parent"
        android:layout_height="140dp"
        android:layout_marginTop="16dp" />

</LinearLayout>