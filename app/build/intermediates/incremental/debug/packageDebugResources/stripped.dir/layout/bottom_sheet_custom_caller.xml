<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="20dp"
        android:background="@drawable/bottom_sheet_bg"
        android:orientation="vertical">

        <!-- Title -->

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/create_custom"
            android:textStyle="bold"
            android:textSize="22sp"
            android:textColor="@color/textcolor" />


        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/add_name_image"
            android:textSize="14sp"
            android:layout_marginTop="4dp"
            android:textColor="@color/textGray" />


        <!-- Profile Image -->

        <FrameLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:padding="@dimen/_10sdp"
            android:layout_marginTop="20dp">

            <!-- Profile Circle -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="100dp"
                android:layout_height="100dp"
                app:cardCornerRadius="60dp"
                app:cardBackgroundColor="#F0EEEE"
                app:strokeColor="#E5E5E5"
                app:strokeWidth="1dp">

                <de.hdodenhof.circleimageview.CircleImageView
                    android:id="@+id/ivProfile"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"/>

            </com.google.android.material.card.MaterialCardView>

            <!-- Camera Icon -->
            <com.google.android.material.card.MaterialCardView

                android:id="@+id/btnSelectImage"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:layout_gravity="bottom|end"
                android:layout_marginEnd="4dp"
                android:layout_marginBottom="4dp"
                app:cardCornerRadius="19dp"
                app:cardBackgroundColor="@color/white"
                app:cardElevation="6dp">

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_camera_new" />

            </com.google.android.material.card.MaterialCardView>

        </FrameLayout>




        <!-- Name -->

        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:boxStrokeColor="#F0EEEE"
            app:boxBackgroundColor="#F0EEEE"
            android:layout_marginTop="16dp">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColorHint="@color/textGray"
                android:textColor="@color/textGray"
                android:hint="@string/caller_name" />

        </com.google.android.material.textfield.TextInputLayout>


        <!-- Video -->

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            app:cardCornerRadius="12dp"
            app:strokeWidth="1dp"
            app:cardBackgroundColor="#F0EEEE"
            app:strokeColor="#F0EEEE">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="15dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">


                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_video_call" />


                <TextView
                    android:id="@+id/tvVideo"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/select_video"
                    android:textColor="@color/textGray"
                    android:paddingStart="12dp"
                    android:textSize="15sp" />


                <ImageView
                    android:id="@+id/btnSelectVideo"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_edit" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>


        <!-- Audio -->

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            app:cardCornerRadius="12dp"
            android:visibility="visible"
            app:strokeWidth="1dp"
            app:cardBackgroundColor="#F0EEEE"
            app:strokeColor="#F0EEEE">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="15dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">


                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_music" />


                <TextView
                    android:id="@+id/tvAudio"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:maxLines="1"
                    android:ellipsize="marquee"
                    android:textColor="@color/textGray"
                    android:text="@string/select_custom"
                    android:paddingStart="12dp"
                    android:textSize="15sp" />


                <ImageView
                    android:id="@+id/btnSelectAudio"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_edit" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>


        <!-- Save Button -->

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSave"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="10dp"
            android:background="@drawable/bg_call_gradient"
            android:text="@string/saved_caller"
            android:textColor="@android:color/white"
            android:textStyle="bold"
            app:backgroundTint="@null" />

    </LinearLayout>

</ScrollView>