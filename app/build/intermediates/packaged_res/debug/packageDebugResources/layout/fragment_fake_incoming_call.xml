<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Background -->
    <ImageView
        android:id="@+id/ivBackground"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:scaleType="centerCrop"
        android:src="@drawable/bg_call"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Overlay -->
    <View
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="#66000000"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />
    <androidx.camera.view.PreviewView
        android:id="@+id/previewView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:keepScreenOn="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />
    <!-- Caller Name -->
    <TextView
        android:id="@+id/tvName"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="50dp"
        android:text="Zendaya"
        android:textColor="@android:color/white"
        android:textSize="34sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Incoming Call -->
    <TextView
        android:id="@+id/tvStatus"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="Incoming Video Call"
        android:textColor="@android:color/white"
        android:textSize="18sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvName" />

    <!-- Caller Image -->
    <de.hdodenhof.circleimageview.CircleImageView
        android:id="@+id/ivCaller"
        android:layout_width="140dp"
        android:layout_height="140dp"
        android:layout_marginTop="20dp"
        android:src="@drawable/hero_one"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvStatus" />

    <!-- Video Off Card -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardVideoOff"
        android:layout_width="220dp"
        android:layout_height="52dp"
        android:layout_marginTop="24dp"
        app:cardBackgroundColor="#5A555C"
        app:cardCornerRadius="26dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/ivCaller">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/camerIcon"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/ic_video_off"
                app:tint="@android:color/white" />

            <TextView
                android:id="@+id/cameraTv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="Turn off your video"
                android:textColor="@android:color/white"
                android:textSize="14sp" />

        </LinearLayout>

    </com.google.android.material.card.MaterialCardView>

    <!-- Swipe Arrows -->
    <LinearLayout
        android:id="@+id/layoutArrows"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="vertical"
        app:layout_constraintBottom_toTopOf="@id/layoutButtons"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <ImageView
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:src="@drawable/ic_arrow_up"
            app:tint="@android:color/white" />

        <ImageView
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:src="@drawable/ic_arrow_up"
            app:tint="@android:color/white" />

        <ImageView
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:src="@drawable/ic_arrow_up"
            app:tint="@android:color/white" />

    </LinearLayout>

    <!-- Bottom Actions -->
    <LinearLayout
        android:id="@+id/layoutButtons"
        android:layout_width="0dp"
        android:layout_height="220dp"
        android:gravity="bottom|center_horizontal"
        android:orientation="horizontal"
        android:paddingBottom="30dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Decline -->
        <LinearLayout
            android:id="@+id/btnDecline"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:gravity="bottom|center_horizontal"
            android:paddingBottom="@dimen/_10sdp"
            android:orientation="vertical">

            <FrameLayout
                android:id="@+id/declineContainer"
                android:layout_width="90dp"
                android:layout_height="140dp">

                <ImageView
                    android:id="@+id/ivDecline"
                    android:layout_width="72dp"
                    android:layout_height="72dp"
                    android:layout_gravity="bottom|center_horizontal"
                    android:background="@drawable/bg_red_circle"
                    android:padding="10dp"
                    android:layout_marginBottom="@dimen/_10sdp"
                    android:src="@drawable/ic_call_end"
                    app:tint="@android:color/white" />

            </FrameLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Decline"
                android:layout_marginTop="@dimen/_5sdp"
                android:textColor="@android:color/white" />

        </LinearLayout>

        <!-- Accept -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:paddingBottom="@dimen/_10sdp"
            android:layout_marginHorizontal="28dp"
            android:gravity="bottom|center_horizontal"
            android:orientation="vertical">

            <FrameLayout
                android:id="@+id/swipeContainer"
                android:layout_width="90dp"
                android:layout_height="140dp">

                <ImageView
                    android:id="@+id/ivSwipeAccept"
                    android:layout_width="72dp"
                    android:layout_height="72dp"
                    android:layout_gravity="bottom|center_horizontal"
                    android:background="@drawable/bg_green_circle"
                    android:padding="18dp"
                    android:src="@drawable/ic_video_call"
                    android:layout_marginBottom="@dimen/_10sdp"
                    app:tint="@android:color/white"/>

            </FrameLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:layout_marginTop="@dimen/_5sdp"
                android:text="@string/swipe_up_to_accept"
                android:textColor="@android:color/white"/>

        </LinearLayout>

        <!-- Message -->
        <LinearLayout
            android:id="@+id/btnMessage"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:paddingBottom="@dimen/_10sdp"
            android:gravity="bottom|center_horizontal"
            android:orientation="vertical">

            <FrameLayout
                android:id="@+id/messageContainer"
                android:layout_width="90dp"
                android:layout_height="140dp">

                <ImageView
                    android:id="@+id/ivMessage"
                    android:layout_width="72dp"
                    android:layout_height="72dp"
                    android:layout_gravity="bottom|center_horizontal"
                    android:background="@drawable/bg_white_circle"
                    android:padding="15dp"
                    android:src="@drawable/ic_message"
                    android:layout_marginBottom="@dimen/_10sdp"
                    app:tint="#666666" />

            </FrameLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_5sdp"
                android:text="Message"
                android:textColor="@android:color/white" />

        </LinearLayout>

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>